# Optional: Set OAuth session token from `claude setup-token`
# Leave empty to use `claude login` authentication
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Playwright MCP Bridge extension token
# Get this from the Playwright MCP Bridge browser extension settings
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=your-extension-token-here

# ElevenLabs Voice Mode (optional - enables mic button in chat)
# Get your API key from https://elevenlabs.io/app/settings/api-keys
# Voice ID from https://elevenlabs.io/app/voice-library (click a voice → copy ID)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Web Push Notifications (VAPID keys)
# Generate a key pair with: python -m app.generate_vapid_keys
# VAPID_PRIVATE_KEY=your-base64-encoded-private-key
# VAPID_PUBLIC_KEY=your-base64-encoded-public-key
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Claude process settings (optional — defaults shown)
# PORT=8000
# CLAUDE_BINARY_PATH=claude
# CLAUDE_WORKDIR=/src
# MAX_CLAUDE_PROCESSES=3
# CLAUDE_PROCESS_TIMEOUT=180
# AGENT_TTL_SECONDS=600
