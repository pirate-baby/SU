# User identity — one SU instance serves one user (USER_NAME required)
# USER_NAME=Alice
# USER_GENDER=female
# SU_NAME=SU

# OAuth session token for Claude Code (uses Pro/Max subscription billing)
# Generate with: claude setup-token
# Leave empty to use ~/.claude credentials from the host mount
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Playwright MCP Bridge extension token
# Get this from the Playwright MCP Bridge browser extension settings
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=your-extension-token-here

# Playwright MCP server URL (optional — defaults to host.docker.internal:8931)
# Override if running the MCP server on a non-default host or port.
# PLAYWRIGHT_MCP_URL=http://host.docker.internal:8931/sse

# ProtonMail (optional — enables email management tools via Proton Bridge)
# Requires Proton Bridge running on the host (installed by provision.sh).
# https://github.com/barhatch/protonmail-mcp-server
# NOTE: PASSWORD is the Bridge mailbox password, NOT your ProtonMail account password.
#       Get it from: Proton Bridge app → Settings → Mailbox Password
# PROTONMAIL_USERNAME=you@proton.me
# PROTONMAIL_PASSWORD=your-bridge-mailbox-password
# PROTONMAIL_SMTP_HOST=127.0.0.1       # Proton Bridge SMTP (use 127.0.0.1, not localhost)
# PROTONMAIL_SMTP_PORT=1025            # Proton Bridge SMTP port
# PROTONMAIL_IMAP_HOST=127.0.0.1       # Proton Bridge IMAP (use 127.0.0.1, not localhost)
# PROTONMAIL_IMAP_PORT=1143            # Proton Bridge IMAP port

# ElevenLabs Voice Mode (optional - enables mic button in chat)
# Get your API key from https://elevenlabs.io/app/settings/api-keys
# Voice ID from https://elevenlabs.io/app/voice-library (click a voice → copy ID)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Web Push Notifications (VAPID keys)
# Generate a key pair with: python -m app.generate_vapid_keys
# VAPID_PRIVATE_KEY=your-base64-encoded-private-key
# VAPID_PUBLIC_KEY=your-base64-encoded-public-key
# VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Vibe Kanban allowed origins (optional — auto-detected from machine IPs)
# Comma-separated list of origins allowed to access the Vibe Kanban API.
# Only needed if auto-detection misses an IP (e.g. a custom domain).
# VK_ALLOWED_ORIGINS=https://my-host.ts.net:53187,https://10.0.0.5:53187

# Claude process settings (optional — defaults shown)
# PORT=8000
# CLAUDE_BINARY_PATH=claude
# CLAUDE_WORKDIR=/src
# MAX_CLAUDE_PROCESSES=3
# CLAUDE_PROCESS_TIMEOUT=180
# AGENT_TTL_SECONDS=600
